{
	admin off
	auto_https off
}

:80 {
	# Post embeds: the landing page, /embed/<did>/<collection>/<rkey> and the
	# snippet script at /static/embed.js
	@embed host embed.krao.net
	handle @embed {
		root * /srv-embed
		encode zstd gzip
		rewrite /static/embed.js /embed.js
		rewrite /embed/* /post.html
		file_server
	}

	# krao.net is the canonical host; the old sandbox host and www redirect to it
	@other_host host krao.vssa.com www.krao.net
	redir @other_host https://krao.net{uri} permanent

	root * /srv
	encode zstd gzip
	@hashed path /_expo/static/* /static/_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# The web build references its files under /static/ (experiments.baseUrl),
	# which upstream's bskyweb server maps onto the bundle
	handle_path /static/* {
		file_server
	}
	handle {
		# Single-page app: unknown paths (eg /profile/x) render index.html
		try_files {path} /index.html
		file_server
	}
}
