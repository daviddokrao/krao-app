# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# Bluesky appview DID
EXPO_PUBLIC_BLUESKY_PROXY_DID=

# PDS for sign up / default sign in (default: https://pds.krao.net)
EXPO_PUBLIC_DEFAULT_SERVICE=

# Public appview for logged-out requests (default: https://api.krao.net)
EXPO_PUBLIC_PUBLIC_API=

# Krao web app, the host of share links (default: https://krao.net)
EXPO_PUBLIC_KRAO_WEB_URL=

# Krao website with the help center and policy pages (default: https://krao.net)
EXPO_PUBLIC_KRAO_SITE_URL=

# Handle domain of accounts on Krao's PDS; profile URLs drop it, so
# krao.net/lan is lan.krao.net (default: .krao.net; the dev-env uses .test)
EXPO_PUBLIC_KRAO_HANDLE_DOMAIN=

# Krao indexer for net.krao.* queries (default: https://indexer.krao.net)
EXPO_PUBLIC_KRAO_INDEXER_URL=

# Built-in test wallet for local development only (true/false)
EXPO_PUBLIC_KRAO_DEV_WALLET=

# WalletConnect (Reown) project ID: lets the mobile apps link wallets, tip and
# open gated posts through a wallet app. Empty: wallets are web-only.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Krao gate service for token-gated posts (default: the indexer URL) and its DID
EXPO_PUBLIC_KRAO_GATE_URL=
EXPO_PUBLIC_KRAO_GATE_DID=

# Link-preview (card) service (default: the indexer URL)
EXPO_PUBLIC_KRAO_LINK_PREVIEW_URL=

# GIF search proxy (default: the indexer URL)
EXPO_PUBLIC_KRAO_GIF_URL=

# Post embed service (a bskyembed deployment); "Embed post" is hidden until set
EXPO_PUBLIC_KRAO_EMBED_URL=

# Short-link service for shared posts (default: <indexer URL>/s)
EXPO_PUBLIC_KRAO_SHORT_LINK_URL=

# Open Graph card image service (default: <indexer URL>/ogcard)
EXPO_PUBLIC_KRAO_OGCARD_URL=

# Video upload/processing service and its DID (default: empty = no video; dev-env: http://localhost:2591)
EXPO_PUBLIC_KRAO_VIDEO_URL=
EXPO_PUBLIC_KRAO_VIDEO_DID=

# Krao chat service URL (default: empty; dev-env: http://localhost:2590)
EXPO_PUBLIC_KRAO_CHAT_URL=

# Krao rewards service: referral codes, points, KYC (default: https://rewards.krao.net) and its DID
EXPO_PUBLIC_KRAO_REWARDS_URL=
EXPO_PUBLIC_KRAO_REWARDS_DID=

# Krao "popular" feed used as Discover; the owner may be a handle (default: at://krao.net/app.bsky.feed.generator/popular)
EXPO_PUBLIC_KRAO_DISCOVER_FEED=

# Krao moderation service (labeler), by DID or handle; unset = no app labeler
EXPO_PUBLIC_KRAO_LABELER=

# Show the GIF picker; needs KRAO_KLIPY_API_KEY on the indexer (true/false)
EXPO_PUBLIC_KRAO_GIF_SEARCH=

# Local Anvil chain the dev wallet sends tips through (default: http://localhost:8545)
EXPO_PUBLIC_KRAO_DEV_RPC_URL=

# Local atproto dev-env (krao-atproto `make run-dev-env`):
# EXPO_PUBLIC_KRAO_INDEXER_URL=http://localhost:2589
# EXPO_PUBLIC_KRAO_CHAT_URL=http://localhost:2590
# EXPO_PUBLIC_KRAO_VIDEO_URL=http://localhost:2591
# EXPO_PUBLIC_KRAO_REWARDS_URL=http://localhost:2592
# EXPO_PUBLIC_KRAO_REWARDS_DID=did:web:rewards.krao.test
# EXPO_PUBLIC_KRAO_DEV_WALLET=true
# EXPO_PUBLIC_KRAO_GATE_DID=did:web:gate.krao.test
# EXPO_PUBLIC_KRAO_DISCOVER_FEED=at://krao.test/app.bsky.feed.generator/popular
# EXPO_PUBLIC_KRAO_LABELER=mod-authority.test
# EXPO_PUBLIC_DEFAULT_SERVICE=http://localhost:2583
# EXPO_PUBLIC_PUBLIC_API=http://localhost:2584
# EXPO_PUBLIC_BLUESKY_PROXY_DID=did:plc:dw4kbjf5mn7nhenabiqpkyh3

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

#
#
# Bluesky specific values
#
#

# Bluesky's metrics API
EXPO_PUBLIC_METRICS_API_HOST=

# Growthbook config
EXPO_PUBLIC_GROWTHBOOK_API_HOST=
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Sentry DSN for telemetry
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# geolocation web worker URL
GEOLOCATION_DEV_URL=

# live-events web worker URL
LIVE_EVENTS_DEV_URL=

# app-config web worker URL
APP_CONFIG_DEV_URL=

# GCP project id for native device attestation (number; unset on web)
EXPO_PUBLIC_GCP_PROJECT_ID=
