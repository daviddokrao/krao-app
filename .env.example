# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# Bluesky appview DID
EXPO_PUBLIC_BLUESKY_PROXY_DID=

# PDS for sign up / default sign in (default: https://bsky.social)
EXPO_PUBLIC_DEFAULT_SERVICE=

# Public appview for logged-out requests (default: https://public.api.bsky.app)
EXPO_PUBLIC_PUBLIC_API=

# Krao indexer for io.krao.* queries (default: https://indexer.krao.io)
EXPO_PUBLIC_KRAO_INDEXER_URL=

# Built-in test wallet for local development only (true/false)
EXPO_PUBLIC_KRAO_DEV_WALLET=

# Krao gate service for token-gated posts (default: the indexer URL) and its DID
EXPO_PUBLIC_KRAO_GATE_URL=
EXPO_PUBLIC_KRAO_GATE_DID=

# Krao "latest" feed used as Discover; the owner may be a handle (default: at://krao.io/app.bsky.feed.generator/latest)
EXPO_PUBLIC_KRAO_DISCOVER_FEED=

# Krao moderation service (labeler), by DID or handle; unset = no app labeler
EXPO_PUBLIC_KRAO_LABELER=

# Local Anvil chain the dev wallet sends tips through (default: http://localhost:8545)
EXPO_PUBLIC_KRAO_DEV_RPC_URL=

# Local atproto dev-env (krao-atproto `make run-dev-env`):
# EXPO_PUBLIC_KRAO_INDEXER_URL=http://localhost:2589
# EXPO_PUBLIC_KRAO_DEV_WALLET=true
# EXPO_PUBLIC_KRAO_GATE_DID=did:web:gate.krao.test
# EXPO_PUBLIC_KRAO_DISCOVER_FEED=at://krao.test/app.bsky.feed.generator/latest
# EXPO_PUBLIC_KRAO_LABELER=mod-authority.test
# EXPO_PUBLIC_DEFAULT_SERVICE=http://localhost:2583
# EXPO_PUBLIC_PUBLIC_API=http://localhost:2584
# EXPO_PUBLIC_BLUESKY_PROXY_DID=did:plc:dw4kbjf5mn7nhenabiqpkyh3

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

#
#
# Bluesky specific values
#
#

# Bluesky's metrics API
EXPO_PUBLIC_METRICS_API_HOST=

# Growthbook config
EXPO_PUBLIC_GROWTHBOOK_API_HOST=
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Sentry DSN for telemetry
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# geolocation web worker URL
GEOLOCATION_DEV_URL=

# live-events web worker URL
LIVE_EVENTS_DEV_URL=

# app-config web worker URL
APP_CONFIG_DEV_URL=
